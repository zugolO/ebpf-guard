*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
.env
.env.*
!.env.example
secrets/
config/secrets.yaml
config/secrets.yml

# ── Kubernetes / Helm generated ────────────────────────────────────────────────
deploy/helm/*/charts/
deploy/helm/*/*.lock

# ── Operator-owned rule tuning overlay (see rules/local-tuning.yaml.example) ───
# Never shipped/updated by rule-set releases; each deployment keeps its own.
rules/local-tuning.yaml

