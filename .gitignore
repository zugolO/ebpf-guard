# ── Binaries ──────────────────────────────────────────────────────────────────
/ebpf-guard
/ebpf-guard.exe
ebpf-guard-linux-*
*.exe
*.test
*.test.exe
e2e.test
e2e.test.exe

# ── Build artifacts ────────────────────────────────────────────────────────────
/bin/
/build/
/dist/
/out/

# ── eBPF generated objects (require clang + Linux to rebuild) ─────────────────
bpf/*.o
internal/bpf/*.o
bpf/*_bpf.go
internal/bpf/*_bpf.go
internal/bpf/*_bpfel.go
internal/bpf/*_bpfeb.go
internal/bpf/*_x86_bpfel.go
internal/bpf/*_arm64_bpfel.go
internal/bpf/*_arm64_bpfeb.go
vmlinux.h
# The pregenerated BTF header IS committed so fresh clones can run
# `make generate` without a BTF-enabled kernel (see Makefile `generate`).
!bpf/vmlinux.h

# Vendored upstream libbpf headers (bpf_helpers.h etc.) — IDE-only, so
# clangd can resolve <bpf/...> includes in bpf/*.bpf.c on machines without
# libbpf installed (e.g. macOS). Not used by the real build; make generate
# uses the system libbpf inside the Linux/Docker toolchain.
bpf/.vendor/

# ── Go toolchain ───────────────────────────────────────────────────────────────
vendor/
coverage.out
coverage.html
*.prof
cpu.prof
mem.prof
trace.out

